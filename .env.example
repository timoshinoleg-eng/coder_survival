# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coder_survival
DB_USER=postgres
DB_PASSWORD=postgres

# Telegram Bot (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_BACKEND_SECRET=your_shared_internal_secret
# Required in production for internal admin endpoints. Store outside Git.
ADMIN_API_SECRET=your_admin_api_secret

# Frontend / WebApp
WEBAPP_URL=http://localhost:5173
# Production CORS entries must be exact HTTPS origins only: no trailing slash,
# path, query, fragment or wildcard. Use one of FRONTEND_URL or the comma-list.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Telegram initData max age (seconds)
INIT_DATA_MAX_AGE_SECONDS=3600

# Rate limiting
RATE_LIMIT_MAX_TAPS_PER_SECOND=15
RATE_LIMIT_SOFT_BAN_THRESHOLD=25
RATE_LIMIT_DAILY_CAP_PER_IP=10000

# Rewarded ads: set provider and only its matching secret in production.
# Supported values: adsgram, propeller. Leave all empty only when ads are not
# configured; production preflight will emit a named warning rather than log a value.
REWARDED_AD_PROVIDER=
ADSGRAM_SECRET=your_adsgram_secret
PROPELLER_SECRET=your_propeller_secret

# Alerting (optional — leave empty to disable)
# Telegram chat ID for receiving alerts (health checks, 5xx spikes, payment failures)
ALERT_CHAT_ID=

# --- Payments (personal non-commercial test mode) ---
# Fail-closed kill switch for ALL real-money paths (Telegram Stars invoices,
# purchase intents, premium pass upgrades).
#
# Payments are ENABLED only when this is the literal lowercase string "true".
# The comparison is exact: no trimming, no case folding. Missing, empty, or any
# other value — "1", "yes", "TRUE", "True", " true " — means DISABLED, so a
# case or whitespace near-miss fails safe. Leave unset for test mode.
#
# While disabled: no invoice can be created, pre_checkout_query is rejected, and
# purchase/upgrade endpoints return HTTP 403 with code PAYMENTS_DISABLED.
# An already-charged payment that still arrives IS fulfilled idempotently (never
# charge-without-delivery) and raises a redacted alert.
PAYMENTS_ENABLED=false
