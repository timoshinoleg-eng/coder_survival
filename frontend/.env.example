# Coder Survival — Frontend Environment Variables
#
# Vite inlines every VITE_* value into the built JavaScript at BUILD time. Those
# values are therefore PUBLIC: anyone can read them in the shipped bundle.
# NEVER put BOT_TOKEN, JWT_SECRET, BOT_BACKEND_SECRET, database URLs, admin
# secrets or any other private value in a VITE_* variable or in a hosting
# provider's frontend environment settings.
#
# CURRENT LIVE frontend: Vercel
#   project prj_6HewqIVhYFQFgim5yQPJjvz6ucHa (team olegs-projects-bfc4e11a)
#   https://frontend-ashy-alpha-77.vercel.app
# CANDIDATE (not deployed): Cloudflare Pages pilot — see
#   docs/CLOUDFLARE_PAGES_PILOT.md

# --- API origin (provider-neutral) ---
# Where the app sends /api requests. The value alone decides this; the hostname
# the app is served from is never inspected.
#
# EMPTY  -> same-origin requests.
#           * Vercel (CURRENT LIVE): correct. frontend/vercel.json rewrites
#             /api/* and /health to https://coder-survival-api.duckdns.org.
#           * local `npm run dev`: correct. Vite proxies /api to :3000.
#
# SET    -> that exact origin is used on every host, including *.vercel.app and
#           *.pages.dev. Required for the Cloudflare Pages pilot, which has no
#           rewrite layer:
#             VITE_API_BASE_URL=https://coder-survival-api.duckdns.org
#           The backend must also allowlist the Pages origin for CORS — see the
#           runbook. Trailing slashes are stripped automatically.
#
# Whitespace-only is treated as EMPTY (same-origin), so a stray space pasted
# into a dashboard field cannot produce a broken " /api/..." request URL.
VITE_API_BASE_URL=

# --- Analytics / ads ---
VITE_AMPLITUDE_API_KEY=
VITE_ADSGRAM_BLOCK_ID=
VITE_ADS_PROVIDER=adsgram

# Rewarded video ads. Keep FALSE for the personal non-commercial pilot: ad
# rewards are monetisation-adjacent and the pilot is explicitly non-commercial.
# Only set true if an already-approved test requirement calls for it.
VITE_ENABLE_REWARDED_ADS=false

# --- Payments (personal non-commercial test mode) ---
# Fail-closed kill switch for the mini app's payment UI. Inlined by Vite at
# BUILD time, so a build made without it can never show payment controls.
#
# Payment controls render only when this is the literal lowercase string "true"
# (no trimming, no case folding). Missing, empty or any other value — including
# "TRUE", "True", " true " — means DISABLED: no Stars/TON controls are shown and
# Telegram's openInvoice is never called. Leave unset for test mode.
#
# Leave EMPTY/ABSENT on every environment, including the Cloudflare Pages pilot.
# Must be kept consistent with the backend/bot PAYMENTS_ENABLED flag.
VITE_PAYMENTS_ENABLED=
