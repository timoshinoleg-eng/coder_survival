  "description": "Coder Survival API — Telegram Mini App backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/migrate.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
