# .env — local development
NODE_ENV=development
PORT=3000

# PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/coder_survival

# Telegram Bot (dev mode — пустой = skip verification)
TELEGRAM_BOT_TOKEN=

# Rate limiting
RATE_LIMIT_MAX_TAPS_PER_SECOND=15
RATE_LIMIT_SOFT_BAN_THRESHOLD=25
RATE_LIMIT_DAILY_CAP_PER_IP=10000
RATE_LIMIT_WINDOW_MS=1000

# Game balance
TIER_THRESHOLDS=100,500,2000,10000
