# Local development defaults. Production uses this same variable contract through
# docker-compose.backend.yml and must populate secrets only in the protected
# operator environment. Never commit a populated backend/.env file.
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coder_survival
DB_USER=postgres
DB_PASSWORD=
DB_PASS=postgres

# PostgreSQL TLS defaults to verified TLS in production. Set DB_SSL=false only
# for a trusted local PostgreSQL instance; use a CA for managed TLS.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
DB_SSL_CA=
DB_SSL_CA_PATH=

# Test PostgreSQL
# Integration tests run only with an explicit, isolated database URL. Never
# point this value at a production or shared staging database.
TEST_DATABASE_URL=

# Telegram and backend-to-bot authentication
BOT_TOKEN=
BOT_BACKEND_SECRET=
ADMIN_API_SECRET=
WEBAPP_URL=http://localhost:5173

# Production browser-origin contract. Use canonical HTTPS origins with no path,
# query, fragment or trailing slash. Multiple origins are comma-separated.
FRONTEND_URL=https://your-production-domain.com
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# Telegram initData max age (seconds)
INIT_DATA_MAX_AGE_SECONDS=3600

# Rate limiting
RATE_LIMIT_MAX_TAPS_PER_SECOND=15
RATE_LIMIT_SOFT_BAN_THRESHOLD=25
RATE_LIMIT_DAILY_CAP_PER_IP=10000

# Game balance (optional overrides)
TIER_THRESHOLDS=100,500,2000,10000

# Rewarded-ad provider contract. Leave provider blank when it is intentionally
# disabled. If declared, the matching secret is required by production preflight.
REWARDED_AD_PROVIDER=
ADSGRAM_SECRET=
PROPELLER_SECRET=

# Analytics
AMPLITUDE_API_KEY=

# Release image identity. The guarded release path sets this from the reviewed
# GitHub commit as git-<40-hex-sha>; never set it to mutable latest.
BACKEND_IMAGE_TAG=

# --- Payments (personal non-commercial test mode) ---
# Fail-closed kill switch for all real-money paths (Telegram Stars invoices,
# purchase intents and premium-pass upgrades). Keep the literal lowercase false
# for every release unless a separate owner-approved change authorizes it.
PAYMENTS_ENABLED=false
