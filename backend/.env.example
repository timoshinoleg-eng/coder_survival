NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coder_survival
DB_USER=postgres
DB_PASSWORD=***
DB_PASS=postgres

# PostgreSQL TLS defaults to verified TLS in production. Set `DB_SSL=false`
# only for a trusted local PostgreSQL instance; use a CA for managed TLS.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
DB_SSL_CA=
DB_SSL_CA_PATH=

# Test PostgreSQL
# Integration tests run only with an explicit, isolated database URL. Never
# point this value at a production or shared staging database.
TEST_DATABASE_URL=

# Telegram
BOT_TOKEN=
WEBAPP_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX_TAPS_PER_SECOND=15
RATE_LIMIT_SOFT_BAN_THRESHOLD=25
RATE_LIMIT_DAILY_CAP_PER_IP=10000

# Telegram initData max age (seconds)
INIT_DATA_MAX_AGE_SECONDS=3600
BOT_BACKEND_SECRET=

# Game balance (optional overrides)
TIER_THRESHOLDS=100,500,2000,10000

# Ad network secrets (optional)
ADSGRAM_SECRET=
PROPELLER_SECRET=

# Analytics & Frontend
AMPLITUDE_API_KEY=
FRONTEND_URL=https://your-production-domain.com

# --- Payments (personal non-commercial test mode) ---
# Fail-closed kill switch for ALL real-money paths (Telegram Stars invoices,
# purchase intents, premium pass upgrades).
#
# Payments are ENABLED only when this is the literal lowercase string "true".
# The comparison is exact: no trimming, no case folding. Missing, empty, or any
# other value — "1", "yes", "TRUE", "True", " true " — means DISABLED, so a
# case or whitespace near-miss fails safe. Leave unset for test mode.
#
# While disabled: no invoice can be created, pre_checkout_query is rejected, and
# purchase/upgrade endpoints return HTTP 403 with code PAYMENTS_DISABLED.
# An already-charged payment that still arrives IS fulfilled idempotently (never
# charge-without-delivery) and raises a redacted alert.
PAYMENTS_ENABLED=
